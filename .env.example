# ── Submission email delivery (required for the Sell form) ─────────────────
# Where submissions are delivered. Comma-separate multiple addresses.
GRAILZCO_SUBMISSION_EMAIL=
# Resend API key — https://resend.com/api-keys  (server-only, never exposed)
RESEND_API_KEY=
# Verified sender, e.g. "Grailz Co Submissions <submissions@yourdomain.com>"
# The domain must be verified in Resend. For local testing only, you can use
# "onboarding@resend.dev", which can deliver only to your own Resend account email.
RESEND_FROM_EMAIL=

# ── Public site settings ───────────────────────────────────────────────────
# Production URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public contact address shown in the footer (leave blank to show "coming soon").
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Optional upload limits (must suit your host's request-body limit) ──────
# NEXT_PUBLIC_SUBMISSION_MAX_TOTAL_MB=4
# NEXT_PUBLIC_SUBMISSION_MAX_IMAGES=12
# NEXT_PUBLIC_SUBMISSION_MAX_CARDS=10
# NEXT_PUBLIC_SUBMISSION_MAX_SOURCE_MB=20
